scale_y_continuous(limits = c(min(pdat$y) - 0.8, 0.5)) +
labs(title = domain_name) +
theme_void(base_size = 10) +
theme(
plot.title = element_text(face = "bold", size = 10,
colour = accent, hjust = 0,
margin = margin(b = 4, l = 4, t = 4)),
plot.background = element_rect(
fill = scales::alpha(accent, 0.07),
colour = "#d0d0d0", linewidth = 0.3
),
plot.margin = margin(2, 8, 6, 8)
)
}
# ---------- Render and arrange ----------
# Heights proportional to item count + 1.5 (for header)
weight <- function(d) sum(items$domain == d) + 1.5
welfare_cards   <- lapply(welfare_domains,   make_card, df = items, accent = welfare_col)
foundation_cards <- lapply(foundation_domains, make_card, df = items, accent = foundation_col)
if (!requireNamespace("patchwork", quietly = TRUE)) {
stop("Install patchwork: install.packages('patchwork')")
}
library(patchwork)
welfare_stack   <- wrap_plots(welfare_cards,   ncol = 1,
heights = sapply(welfare_domains, weight))
foundation_stack <- wrap_plots(foundation_cards, ncol = 1,
heights = sapply(foundation_domains, weight))
header_strip <- function(label, accent) {
ggplot() +
annotate("rect", xmin = 0, xmax = 1, ymin = 0, ymax = 1,
fill = accent, colour = NA) +
annotate("text", x = 0.5, y = 0.5, label = label,
fontface = "bold", size = 4, colour = "white") +
xlim(0, 1) + ylim(0, 1) +
theme_void()
}
left_col  <- header_strip("WELFARE DOMAINS",       welfare_col)   /
welfare_stack +
plot_layout(heights = c(0.4, sum(sapply(welfare_domains, weight))))
right_col <- header_strip("REPORTING FOUNDATIONS",  foundation_col) /
foundation_stack +
plot_layout(heights = c(0.4, sum(sapply(foundation_domains, weight))))
# Paper info header
header <- ggplot() +
annotate("text", x = 0, y = 0.82, label = paper_info$title,
fontface = "bold", size = 5, hjust = 0) +
annotate("text", x = 0, y = 0.48,
label = paste(paper_info$authors, "  -  ", paper_info$journal),
size = 3.4, hjust = 0, colour = "#444444") +
annotate("text", x = 0, y = 0.18, label = paper_info$version,
size = 2.8, hjust = 0, colour = "#888888", fontface = "italic") +
xlim(0, 1) + ylim(0, 1) +
theme_void()
footer <- ggplot() +
annotate("text", x = 0, y = 0.6,
label = "Empty fields = item not reported   -   \"Not applicable\" = not relevant to this study",
size = 2.8, hjust = 0, colour = "#666666") +
annotate("text", x = 0, y = 0.15,
label = "Generated with the invertreport R package and web tool",
size = 2.8, hjust = 0, colour = "#888888", fontface = "italic") +
xlim(0, 1) + ylim(0, 1) +
theme_void()
fig <- header / (left_col | right_col) / footer +
plot_layout(heights = c(0.9, 12, 0.7))
# ---------- Save ----------
out_dir <- "../figs"
if (!dir.exists(out_dir)) dir.create(out_dir, recursive = TRUE)
ggsave(file.path(out_dir, "compliance_figure_mockup.png"),
fig, width = 8.5, height = 11, dpi = 300, bg = "white")
ggsave(file.path(out_dir, "compliance_figure_mockup.pdf"),
fig, width = 8.5, height = 11, bg = "white")
# Build the Figure 1 exemplar for the manuscript: the invertreport
# framework applied to Manzi et al. (2026) "Flexible self-protection as
# evidence of pain-like states in house crickets", Proc. R. Soc. B.
#
# Run from the project root. Output lands in figs/.
library(invertreport)
items <- framework_template()
# --- Subjects ---
items$value[items$item_id == "subjects_taxon"] <-
"Acheta domesticus (house cricket); adults of both sexes"
items$value[items$item_id == "subjects_source"] <-
"Commercially reared; Petstock (Australia); founding stock and generations in captivity not recorded"
items$value[items$item_id == "subjects_n"] <-
"n = 80 adults (40 M, 40 F); all analysed; fully within-subjects design; sample size not formally justified"
# --- Nutrition ---
items$value[items$item_id == "nutrition_diet"] <-
"Wheatgerm ad libitum; peaches in juice as combined food and water source; no pre-experimental fasting"
# --- Environment ---
items$value[items$item_id == "env_housing"] <-
"Shared holding containers 40 x 40 x 100 cm; 12:12 L:D; 23 plus/minus 1 C. Test arenas 30 x 22 x 10.5 cm at ~100 lux (low-stress) or ~1000 lux (high-stress)"
items$value[items$item_id == "env_acclimation"] <- ""    # not reported
items$value[items$item_id == "env_field"]       <- "NA"  # laboratory only
# --- Health ---
items$value[items$item_id == "health_monitoring"] <-
"Crickets monitored throughout the trial period (daily checks of responsiveness and condition); no formal scoring rubric"
items$value[items$item_id == "health_injury"] <-
"No injuries or unexpected deaths; all individuals lived out their natural lifespans post-experiment with no lasting effects"
# --- Behaviour ---
items$value[items$item_id == "behaviour_general"] <-
"Arena context deliberately varied in cover, substrate and illumination as part of the stress manipulation; 10-min intertrial interval in individual holding containers"
# --- Affective state ---
items$value[items$item_id == "affect_indicators"] <-
"Site-directed grooming of focal antenna as pain-like behavioural indicator; 65 C noxious probe set point chosen to elicit response while avoiding lasting tissue damage (per Gibbons et al. 2024)"
# --- Procedures ---
items$value[items$item_id == "proc_handling"] <-
"Crickets gently immobilized on a sponge for each treatment application; immediately transferred to observation arena; identical handling across all three treatments"
items$value[items$item_id == "proc_anaesthesia"] <-
"Sponge immobilization only; no anaesthesia or analgesia (noxious heat was the experimental treatment)"
items$value[items$item_id == "proc_biosecurity"] <- ""   # not reported
# --- Fate ---
items$value[items$item_id == "fate_end"] <-
"Returned to housing containers after the study and lived out their natural lifespans under continued laboratory care with free access to food and water"
# --- Ethics & compliance ---
items$value[items$item_id == "ethics_review"] <-
"No formal ethics approval required in Australia for invertebrate research; welfare reasoning explicitly provided in lieu (see Ethics statement)"
items$value[items$item_id == "ethics_endpoints"] <-
"No early termination triggered; all individuals completed the protocol without harm and lived out their natural lifespans in captivity"
items$value[items$item_id == "ethics_statement"] <-
"Welfare reasoning given: stable environment, continuous food and water, probe set to avoid lasting harm, post-study return to housing"
# --- Build and save ---
report <- invert_report(
paper = list(
title   = "Flexible self-protection as evidence of pain-like states in house crickets",
authors = "Manzi, Lynch, Allman, Latty, & White (2026)",
journal = "Proc. R. Soc. B 293: 20260609"
),
items = items
)
report   # coverage summary
save_report(report, "figs/fig_S1_welfare_reporting_manzi.pdf")
# --------------------------------------------------------------------
# Standardised methods-digest figure for invertebrate welfare reporting
# Companion to White et al. (in prep)
#
# Inputs:  a data.frame of the 18 framework items with substantive
#          content per item; a list of paper metadata
# Output:  one-page PDF/PNG laid out as a structured methods digest,
#          analogous to a PRISMA flow diagram in carrying the actual
#          information rather than just compliance status
#
# Empty `value` => rendered as "Not reported" (muted italic)
# value == "NA" => rendered as "Not applicable" (grey italic)
#
# Implementation note: this is the standalone mockup. The accompanying
# `invertreport` package wraps the same logic with input validation
# and a Shiny front-end.
# --------------------------------------------------------------------
library(ggplot2)
library(dplyr)
library(tibble)
library(grid)
library(scales)
# ---------- Mock paper ----------
paper_info <- list(
title    = "Field collection and laboratory choice trials in Bombus terrestris",
authors  = "Smith, Jones, & Lee (2025)",
journal  = "Behavioral Ecology, 36(4): 451-462",
version  = "Invertebrate welfare reporting framework v1.0"
)
items <- tibble::tribble(
~group,      ~domain,               ~item,                                                   ~value,
"foundation", "Subjects",            "Taxonomic ID, life stage, sex",                          "Bombus terrestris (worker f); morphological + COI molecular confirmation",
"foundation", "Subjects",            "Source & culture history",                               "Wild-collected, Royal NP NSW (May 2025); 1 commercial colony (Koppert, F2)",
"foundation", "Subjects",            "Sample size & attrition",                                "n=80 collected; n=72 in analysis (10% pre-trial attrition); a priori power",
"welfare",   "Nutrition",           "Diet, feeding, water",                                   "30% w/v sucrose ad libitum + commercial pollen; water dish refreshed daily",
"welfare",   "Environment",         "Housing & abiotic conditions",                           "30x30x30 cm acrylic cages; 24+/-1 C; 60% RH; L:D 12:12; dim red in dark phase",
"welfare",   "Environment",         "Acclimation",                                            "",
"welfare",   "Environment",         "Field site & collection",                                "Heathland, Royal NP NSW (33.9S 151.2E); austral autumn; hand-net only",
"welfare",   "Health",              "Health monitoring",                                      "Daily checks: activity, posture, integument, autotomy",
"welfare",   "Health",              "Injury & mortality",                                     "3 deaths over 14 d (suspected handling stress); no protocol change",
"welfare",   "Behaviour",           "Behavioural opportunities, enrichment, & disturbance",   "Foraging substrate + natural debris in cages; handling minimised to <=1x/day",
"welfare",   "Affective state",     "Indicators & precautionary measures",                    "Lethargy and feeding cessation monitored; cold anaesthesia applied precautionarily for handling",
"foundation", "Procedures",          "Capture, transport, & handling",                         "Hand-net; <2 h transit in ventilated containers; cold immobilisation for marking",
"foundation", "Procedures",          "Anaesthesia, analgesia, & invasive procedures",          "NA",
"foundation", "Procedures",          "Containment & biosecurity",                              "Double-door rearing room; spent animals frozen before disposal",
"foundation", "Fate",                "End of study",                                           "CO2 then freezing (<=-20 C); 30 vouchers deposited at Australian Museum (accession TBD)",
"foundation", "Ethics & compliance", "Ethics review, permits, & conservation status",          "No formal review required; welfare reasoning in Methods. NSW collection permit SL101234. IUCN: Least Concern",
"foundation", "Ethics & compliance", "Humane endpoints & non-target impacts",                  "Endpoint >10% mortality in 48 h (not triggered); no non-target captures",
"foundation", "Ethics & compliance", "Welfare & 3Rs statement",                                "Reduction: paired within-subject design. Refinement: cold anaesthesia for handling. No invasive procedures."
)
welfare_domains   <- c("Nutrition", "Environment", "Health",
"Behaviour", "Affective state")
foundation_domains <- c("Subjects", "Procedures", "Fate",
"Ethics & compliance")
welfare_col   <- "#3F7A3A"
foundation_col <- "#2E5F8E"
# ---------- Helper: build a single domain "card" as a ggplot ----------
make_card <- function(domain_name, df, accent) {
d <- df %>% dplyr::filter(domain == domain_name)
# Build per-item label/value blocks
rows <- lapply(seq_len(nrow(d)), function(i) {
val <- d$value[i]
if (is.na(val) || val == "") {
list(label = d$item[i], value = "Not reported",
style = "italic", colour = "#a8a8a8")
} else if (val == "NA") {
list(label = d$item[i], value = "Not applicable",
style = "italic", colour = "#7a7a7a")
} else {
list(label = d$item[i], value = val,
style = "plain", colour = "#1f1f1f")
}
})
# Compose into a single labelled text block per item using paste
block_text <- vapply(rows, function(r) {
paste0("**", r$label, "**\n", r$value)
}, character(1))
# Use one grob per item: label bold on top, value below
# We'll just lay them out via geom_text inside a faceted-style ggplot
# Each item placed at y = -i (negative so they stack top-down)
pdat <- tibble(
y = -seq_along(rows),
label = sapply(rows, `[[`, "label"),
value = sapply(rows, `[[`, "value"),
style = sapply(rows, `[[`, "style"),
colour = sapply(rows, `[[`, "colour")
)
ggplot(pdat, aes(y = y)) +
geom_text(aes(x = 0, label = label),
hjust = 0, vjust = 1, size = 2.5, fontface = "bold",
colour = "#5a5a5a") +
geom_text(aes(x = 0, y = y - 0.35, label = value),
hjust = 0, vjust = 1, size = 2.7, lineheight = 0.95,
fontface = ifelse(pdat$style == "italic", "italic", "plain"),
colour = pdat$colour) +
scale_x_continuous(limits = c(-0.02, 1), expand = c(0, 0)) +
scale_y_continuous(limits = c(min(pdat$y) - 0.8, 0.5)) +
labs(title = domain_name) +
theme_void(base_size = 10) +
theme(
plot.title = element_text(face = "bold", size = 10,
colour = accent, hjust = 0,
margin = margin(b = 4, l = 4, t = 4)),
plot.background = element_rect(
fill = scales::alpha(accent, 0.07),
colour = "#d0d0d0", linewidth = 0.3
),
plot.margin = margin(2, 8, 6, 8)
)
}
# ---------- Render and arrange ----------
# Heights proportional to item count + 1.5 (for header)
weight <- function(d) sum(items$domain == d) + 1.5
welfare_cards   <- lapply(welfare_domains,   make_card, df = items, accent = welfare_col)
foundation_cards <- lapply(foundation_domains, make_card, df = items, accent = foundation_col)
if (!requireNamespace("patchwork", quietly = TRUE)) {
stop("Install patchwork: install.packages('patchwork')")
}
library(patchwork)
welfare_stack   <- wrap_plots(welfare_cards,   ncol = 1,
heights = sapply(welfare_domains, weight))
foundation_stack <- wrap_plots(foundation_cards, ncol = 1,
heights = sapply(foundation_domains, weight))
header_strip <- function(label, accent) {
ggplot() +
annotate("rect", xmin = 0, xmax = 1, ymin = 0, ymax = 1,
fill = accent, colour = NA) +
annotate("text", x = 0.5, y = 0.5, label = label,
fontface = "bold", size = 4, colour = "white") +
xlim(0, 1) + ylim(0, 1) +
theme_void()
}
left_col  <- header_strip("WELFARE DOMAINS",       welfare_col)   /
welfare_stack +
plot_layout(heights = c(0.4, sum(sapply(welfare_domains, weight))))
right_col <- header_strip("REPORTING FOUNDATIONS",  foundation_col) /
foundation_stack +
plot_layout(heights = c(0.4, sum(sapply(foundation_domains, weight))))
# Paper info header
header <- ggplot() +
annotate("text", x = 0, y = 0.82, label = paper_info$title,
fontface = "bold", size = 5, hjust = 0) +
annotate("text", x = 0, y = 0.48,
label = paste(paper_info$authors, "  -  ", paper_info$journal),
size = 3.4, hjust = 0, colour = "#444444") +
annotate("text", x = 0, y = 0.18, label = paper_info$version,
size = 2.8, hjust = 0, colour = "#888888", fontface = "italic") +
xlim(0, 1) + ylim(0, 1) +
theme_void()
footer <- ggplot() +
annotate("text", x = 0, y = 0.6,
label = "Empty fields = item not reported   -   \"Not applicable\" = not relevant to this study",
size = 2.8, hjust = 0, colour = "#666666") +
annotate("text", x = 0, y = 0.15,
label = "Generated with the invertreport R package and web tool",
size = 2.8, hjust = 0, colour = "#888888", fontface = "italic") +
xlim(0, 1) + ylim(0, 1) +
theme_void()
fig <- header / (left_col | right_col) / footer +
plot_layout(heights = c(0.9, 12, 0.7))
# ---------- Save ----------
out_dir <- "../figs"
if (!dir.exists(out_dir)) dir.create(out_dir, recursive = TRUE)
ggsave(file.path(out_dir, "compliance_figure_mockup.png"),
fig, width = 8.5, height = 11, dpi = 300, bg = "white")
ggsave(file.path(out_dir, "compliance_figure_mockup.pdf"),
fig, width = 8.5, height = 11, bg = "white")
getwd()
